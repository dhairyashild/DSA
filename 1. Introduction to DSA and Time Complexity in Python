# 27:39 - Types of analysis
Time complexity analysis can be done in THREE different ways:
1. BEST CASE (Omega - Ω)
2. AVERAGE CASE (Theta - Θ)  
3. WORST CASE (Big O - O)

# 35:07 - Constant time = N=5
# 39:01 - Linear time  == 2X+7  == 1 FOR LOOP + 1FOR  + 1 WHILE SEPARATELY
# 49:44 - Quadratic time     == SQUARE   == FOR * FOR  (1 FOR DEPEND ON ANOTHER FOR LOOP )
# 57:43 - Cubic time     == CUBE       ==  FOR * FOR * FOR 
# 1:03:00 - Logarithmic time  == LOG(N)  == ANY OF 2 LOOP WITH n VALUE DOUBLED EACH TIME OR HALVED EACH TIME

# =====================================================
# COMPLEXITY RULES (n = input size)
# =====================================================

# 1. SIMPLE OPERATIONS → O(1)
# Individual operations take constant time
x = 5 + 3          # addition
y = x * 2          # multiplication
z = x > y          # comparison
print(z)           # output



# 2. SINGLE LOOP → O(n)
for i in range(n):     # runs n times
    print(i)           # O(1) operation
# Total: n × O(1) = O(n)

# 3. SEQUENTIAL LOOPS → O(n) 
for i in range(n):     # first loop: O(n)
    print(i)
for j in range(n):     # second loop: O(n)
    print(j)
# Total: O(n) + O(n) = O(2n) → O(n)





# 4. NESTED LOOPS → MULTIPLY COMPLEXITIES
# O(n²) - Quadratic
for i in range(n):          # outer: n times
    for j in range(n):      # inner: n times
        print(i, j)         # n × n = n² operations

# O(nm) - Different dimensions
for i in range(n):          # outer: n times
    for j in range(m):      # inner: m times
        print(i, j)         # n × m operations






# O(n³) - Cubic (three nested loops)
for i in range(n):
    for j in range(n):
        for k in range(n):
            print(i, j, k)  # n × n × n = n³ operations





# 5. LOOP THAT DOUBLES/HALVES → O(log n)
# Halving (like binary search)
i = n
while i > 1:
    i = i // 2          # halves each step
    print(i)            # runs log₂(n) times

# Doubling
i = 1
while i < n:
    i = i * 2           # doubles each step
    print(i)            # runs log₂(n) times

# =====================================================
# COMPLEXITY TYPES & EXAMPLES
# =====================================================

# O(1) - CONSTANT TIME
def constant_time(arr):
    return arr[0]           # always 1 operation

# O(n) - LINEAR TIME
def linear_time(arr):
    total = 0
    for item in arr:        # n operations
        total += item
    return total

# O(n²) - QUADRATIC TIME
def quadratic_time(arr):
    pairs = []
    for i in arr:            # n times
        for j in arr:        # n times
            pairs.append((i, j))
    return pairs             # n² pairs

# O(n³) - CUBIC TIME
def cubic_time(arr):
    triplets = []
    for i in arr:            # n times
        for j in arr:        # n times
            for k in arr:    # n times
                triplets.append((i, j, k))
    return triplets          # n³ triplets

# O(log n) - LOGARITHMIC TIME
def logarithmic_time(n):
    steps = 0
    while n > 1:
        n = n // 2          # halves each step
        steps += 1
    return steps            # log₂(n) steps

# =====================================================
# COMPLEXITY GROWTH ORDER (Slowest → Fastest)
# =====================================================
# O(1) < O(log n) < O(n) < O(n log n) < O(n²) < O(n³)

# Visual comparison for n = 10:
# O(1):      1 operation
# O(log n):  ~3 operations (log₂10 ≈ 3.32)
# O(n):      10 operations
# O(n log n): 33 operations (10 × 3.32)
# O(n²):     100 operations
# O(n³):     1000 operations

