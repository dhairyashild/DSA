1. CHECK IF EMPTY  2. FIRST node will attach when added  3. EVERY list needs a "head pointer" - even empty ones


    def add_front(self, value):
        t1 = Node(value)    # NEW CARRIAGE: Just arrived at the platform
        t1.next = self.head # next= HOOK ON BOTH SIDE OF T1 CONSIDER 
        self.head = t1      # NEW DRIVER SEAT: Driver moves to the new front car

    def add_back(self, value):
        t1 = Node(value)    # NEW CARRIAGE: Waiting at the end of the track
        if not self.head:   # EMPTY TRACK: No train exists yet
            self.head = t1  # FIRST CAR: Driver enters the only carriage
            return
        
        temp = self.head    # TICKET MAN: Starts walking from the Driver's car
        while temp.next:    # WALKING: He moves until he finds the last car
            temp = temp.next# STEPPING: Moves from one car to the next
            
        temp.next = t1      # FINAL LINK: Snaps the last car's hook to the new car

    def show(self):
        temp = self.head    # TICKET MAN: Starts at the front to count
        while temp: 
            print(f"[{temp.data}]", end=" → ")
            temp = temp.next# MOVE: Walking to the next carriage
        print("END OF TRACK")

