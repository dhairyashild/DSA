# Q8: CYCLE ✓ (MEDIUM - Floyd's algorithm)
# Hare catches tortoise in loop
# =====================================================
def has_cycle(head):
    slow, fast = head, head
    while fast and fast.next:
        slow = slow.next
        fast = fast.next.next
        if slow == fast: return True
    return False

