# SLL COMPLETE INTERVIEW CODE + TRAIN STORY ✓

class Node:
    def __init__(self, data):
        self.data = data    # [PASSENGERS] inside the carriage
        self.next = None    # [HOOK] rear coupling

# =====================================================
# Q1: CREATE + PRINT ✓
# Analogy: Ticket collector walking to the end of the track.
# =====================================================
def create_print(head):
    temp = head # Collector starts at the Engine
    while temp: 
        print(temp.data, end="→")
        temp = temp.next # Step to the next carriage
    print("None")

# =====================================================
# Q2-3: INSERT HEAD/END ✓
# Analogy Head: Cutting in line at the very front.
# Analogy End: Walking to the last car to add a new one.
# =====================================================
def insert_head(head, data):
    t1 = Node(data)
    t1.next = head # Hook new car to the old first car
    return t1      # New car is now the start

def insert_end(head, data):
    t1 = Node(data)
    if not head: return t1
    temp = head
    while temp.next: temp = temp.next # Find the car with an empty hook
    temp.next = t1 # Snap the hook onto the new car
    return head

# =====================================================
# Q4: INSERT POS k ✓
# Analogy: Unhooking the train at a specific point to slide a car in.
# =====================================================
def insert_pos(head, pos, data):
    t1 = Node(data)
    if pos == 0: return insert_head(head, data)
    temp = head
    for i in range(pos-1): # Walk to the car BEFORE the gap
        if temp.next: temp = temp.next
        else: return head
    t1.next = temp.next # New car hooks to the back half
    temp.next = t1      # Front half hooks to the new car
    return head

# =====================================================
# Q5: DELETE VALUE ✓
# Analogy: Skipping over a broken carriage.
# =====================================================
def delete_val(head, data):
    if head and head.data == data: return head.next
    temp = head
    while temp and temp.next:
        if temp.next.data == data:
            temp.next = temp.next.next # Unhook the target, link neighbors
            return head
        temp = temp.next
    return head

# =====================================================
# Q6: REVERSE ✓
# Analogy: Walking through the train and flipping every hook backward.
# =====================================================
def reverse(head):
    prev, curr = None, head
    while curr:
        t1 = curr.next     # Remember the next car
        curr.next = prev   # Flip the hook backward
        prev = curr        # Move markers forward
        curr = t1
    return prev # The old last car is now the Engine

# =====================================================
# Q7-8: MIDDLE + CYCLE ✓
# Analogy: One person walks (Slow), one person runs (Fast).
# =====================================================
def middle(head):
    slow, fast = head, head
    while fast and fast.next:
        slow = slow.next; fast = fast.next.next
    return slow.data # Slow is at the center of the train

def has_cycle(head):
    slow, fast = head, head
    while fast and fast.next:
        slow = slow.next; fast = fast.next.next
        if slow == fast: return True # They met! The track is a loop.
    return False

# =====================================================
# Q9: REMOVE Nth END ✓
# Analogy: Using a "measuring tape" (gap) to find the Nth car from back.
# =====================================================
def remove_nth_end(head, n):
    dummy = Node(0); dummy.next = head
    left, right = dummy, head
    for i in range(n): right = right.next # Gap created
    while right:
        left, right = left.next, right.next
    left.next = left.next.next # Delete the targeted car
    return dummy.next

