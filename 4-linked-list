# =====================================================
# Q1: CREATE + PRINT ✓ (MOST IMPORTANT - Always asked first!)
# Ticket collector walks from Engine to end of track
# =====================================================
def create_print(head):
    temp = head
    while temp: 
        print(temp.data, end="→")
        temp = temp.next
    print("None")

# =====================================================
# Q2: INSERT HEAD ✓ (HIGH PRIORITY - Easy first question)  
# Cut new car in front of Engine
# =====================================================
def insert_head(head, data):
    t1 = Node(data)
    t1.next = head
    return t1

# =====================================================
# Q3: INSERT END ✓ (HIGH PRIORITY - Common follow-up)
# Walk to last car, snap new car to empty hook
# =====================================================
def insert_end(head, data):
    t1 = Node(data)
    if not head: return t1
    temp = head
    while temp.next: temp = temp.next
    temp.next = t1
    return head

# =====================================================
# Q4: INSERT POS k ✓ (MEDIUM - Tests loops + edge cases)
# Unhook at position k, slide new car in gap
# =====================================================
def insert_pos(head, pos, data):
    t1 = Node(data)
    if pos == 0: return insert_head(head, data)
    temp = head
    for i in range(pos-1):
        if temp.next: temp = temp.next
        else: return head
    t1.next = temp.next
    temp.next = t1
    return head

# =====================================================
# Q5: DELETE VALUE ✓ (MEDIUM-HIGH - Tests prev/next logic)
# Skip broken carriage by linking neighbors
# =====================================================
def delete_val(head, data):
    if head and head.data == data: return head.next
    temp = head
    while temp and temp.next:
        if temp.next.data == data:
            temp.next = temp.next.next
            return head
        temp = temp.next
    return head

# =====================================================
# Q9: REMOVE Nth END ✓ (HIGH - Two pointer favorite!)
# Measuring tape trick: Gap = n nodes
# =====================================================
def remove_nth_end(head, n):
    dummy = Node(0); dummy.next = head
    left, right = dummy, head
    for i in range(n): right = right.next
    while right:
        left, right = left.next, right.next
    left.next = left.next.next
    return dummy.next

# =====================================================
# Q6: REVERSE ✓ (MEDIUM - Pointer reversal mastery)
# Flip every hook backward as you walk
# =====================================================
def reverse(head):
    prev, curr = None, head
    while curr:
        t1 = curr.next
        curr.next = prev
        prev = curr
        curr = t1
    return prev

# =====================================================
# Q7: MIDDLE ✓ (MEDIUM - Two pointer classic)
# Slow tortoise vs Fast hare race
# =====================================================
def middle(head):
    slow, fast = head, head
    while fast and fast.next:
        slow = slow.next
        fast = fast.next.next
    return slow.data

# GET MIDDLE LINK
def find_middle(self):
    if not self.head: return None
    
    slow = self.head     # slow=10
    fast = self.head     # fast=10
    
    # WHILE: 10 and 20 → fast.next=20(True), fast.next.next=30(True)
    while fast.next and fast.next.next:
        slow = slow.next      # slow=20  
        fast = fast.next.next # fast=30
        
        # NEXT LOOP: fast.next=40(True), fast.next.next=50(True)  
        # slow=30, fast=50 → STOP (fast.next.next=None)
    
    return slow.data  # Returns 30 ✓
