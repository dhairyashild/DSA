# =====================================================
# ARRAYS in DSA - PYTHON (array module) - COMPLETE NOTES
# =====================================================
# Foundation for 90% DSA: two-pointer, stacks, sliding window, etc.
from array import *

# 1. CREATION + TYPECODES (homogeneous only!)
# 'i'=int(2B), 'l'=long(4B), 'f'=float(4B), 'd'=double(8B), 'u'=unicode
vals = array('i', [1, 2, 3, 4, 5])      # Integer array
# vals = array('d', [1.5, 2.3, 3.7])    # Float array (use 'd'/'f')
print(vals)         # array('i', [1, 2, 3, 4, 5])
print(len(vals))    # 5 (dynamic sizing!)

# 2. ACCESS + UPDATE (O(1) - core DSA advantage)
print(vals[0])      # 1 (0-indexed)
vals[2] = 200       # Override: [1, 2, 200, 4, 5]
print(vals.typecode) # 'i'

# 3. PRINTING (2 ways - practice both for interviews)
print("Indexed loop:")
for i in range(len(vals)): print(vals[i], end=' ')  # 1 2 200 4 5
print("\nEnhanced loop:")
for x in vals: print(x, end=', ')                   # 1, 2, 200, 4, 5,

# 4. MODIFY (Insert/Append/Update)
vals.append(10)         # [1,2,200,4,5,10] - end
vals.insert(1, 50)      # [1,50,2,200,4,5,10] - shifts right
vals.reverse()          # [10,5,4,200,2,50,1]

# 5. DELETE (Pop)
vals.pop()              # Remove LAST: [10,5,4,200,2,50]
vals.pop(2)             # Remove index 2: [10,5,200,2,50]

# 6. COPY NEW ARRAY (with transformation!)
copy_arr = array(vals.typecode, [x*3 for x in vals])
# copy_arr: array('i', [30,15,600,6,150])

# 7. ERROR HANDLING (common interview trap)
# vals = array('i', [1,2,3.5])  # ERROR: float in int array!
# Fix: Use 'd' for floats: array('d', [1,2,3.5])

