nums=[1,0,1,1]

def containsNearbyDuplicate(nums, k):
    indices = {}  # HashMap: num → LAST seen index
    
    for ind, val in enumerate(nums):  # val वापरतो
        if val in indices and ind - indices[val] <= k:  # val वापरतो
            return True
        indices[val] = ind  # val वापरतो
    
    return False
