# BUBBLE SORT FUNCTION - Python (Interview Ready) 🚀

def bubble_sort(arr):
    n = len(arr)
    for i in range(n-1):              # n-1 passes
        for j in range(n-i-1):        # Skip sorted part
            if arr[j] > arr[j+1]:     # Compare adjacent
                arr[j], arr[j+1] = arr[j+1], arr[j]  # Swap
    return arr

# TEST
a = [99, 88, 77, 66, 55]
bubble_sort(a)
print(a)  # [55, 66, 77, 88, 99]

# Time: O(n²) | Space: O(1)
    






