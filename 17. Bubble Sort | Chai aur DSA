class Sort():
    def __init__(self, lst):
        self.lst= lst
        self.n=len(lst)

    def sorting(self):
        for i in range(0,self.n-1):
            for j in range(self.n-1-i):
                if self.lst[j+1]<self.lst[j]:
                     self.lst[j],self.lst[j+1]=self.lst[j+1],self.lst[j]

