# 4. REVERSE STACK (Iterative/Recursive)
def reverseStack(s):  # 1→2→3 → 3→2→1
    temp = Stack()
    while not s.isEmpty():
        temp.push(s.pop())
    s.items = temp.items  # Swap

# 5. DAILY TEMPS (LeetCode 739) - Monotonic Stack
def dailyTemperatures(temps):  # [73,74,75,71,69] → [1,1,4,2,1]
    res = [0] * len(temps)
    stack = []
    for i, t in enumerate(temps):
        while stack and temps[stack[-1]] < t:
            res[stack.pop()] = i - stack[-1] if stack else 0
        stack.append(i)
    return res

