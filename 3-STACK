# 2. NEXT GREATER ELEMENT (LeetCode 496)
def nextGreater(nums):  # [2,1,2,4,3] → [4,2,4,-1,-1]
    res = [-1] * len(nums)
    stack = []  # Monotonic decreasing
    for i in range(len(nums)):
        while stack and nums[stack[-1]] < nums[i]:
            res[stack.pop()] = nums[i]
        stack.append(i)
    return res

