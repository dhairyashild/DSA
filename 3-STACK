# STACK: LIFO | O(1) push/pop | List: append/pop() 🚀
class Stack:
    def __init__(self): self.items = []
    def push(self, x): self.items.append(x)
    def pop(self): return self.items.pop() if self.items else None
    def peek(self): return self.items[-1] if self.items else None
    def isEmpty(self): return not self.items
    def size(self): return len(self.items)

# === TOP 5 INTERVIEW QUESTIONS ===
# 1. VALID PARENTHESES (LeetCode 20) - 80% interviews
def isValid(s):  # ()[]{}
    stack = Stack()
    pairs = {')':'(', '}':'{', ']':'['}
    for c in s:
        if c in pairs:  # Closing?
            if stack.isEmpty() or stack.pop() != pairs[c]:
                return False
        else: stack.push(c)  # Opening → push
    return stack.isEmpty()

print(isValid("()[]{}"))  # True
print(isValid("(]"))      # False

# 2. NEXT GREATER ELEMENT (LeetCode 496)
def nextGreater(nums):  # [2,1,2,4,3] → [4,2,4,-1,-1]
    res = [-1] * len(nums)
    stack = []  # Monotonic decreasing
    for i in range(len(nums)):
        while stack and nums[stack[-1]] < nums[i]:
            res[stack.pop()] = nums[i]
        stack.append(i)
    return res

# 3. MIN STACK (LeetCode 155) - O(1) min
class MinStack:
    def __init__(self):
        self.stack = []
        self.minstack = []  # Track mins
    
    def push(self, x):
        self.stack.append(x)
        if not self.minstack or x <= self.minstack[-1]:
            self.minstack.append(x)
    
    def pop(self): 
        if self.stack.pop() == self.minstack[-1]:
            self.minstack.pop()
    
    def getMin(self): return self.minstack[-1]

# 4. REVERSE STACK (Iterative/Recursive)
def reverseStack(s):  # 1→2→3 → 3→2→1
    temp = Stack()
    while not s.isEmpty():
        temp.push(s.pop())
    s.items = temp.items  # Swap

# 5. DAILY TEMPS (LeetCode 739) - Monotonic Stack
def dailyTemperatures(temps):  # [73,74,75,71,69] → [1,1,4,2,1]
    res = [0] * len(temps)
    stack = []
    for i, t in enumerate(temps):
        while stack and temps[stack[-1]] < t:
            res[stack.pop()] = i - stack[-1] if stack else 0
        stack.append(i)
    return res

