# LIFO: Last In, First Out | List: append/pop = O(1)

## STEP 1: Basic Class + Push/Pop
class Stack:
    def __init__(self):        # Initialize empty stack
        self.items = []        # Use list as internal storage
    
    def push(self, item):      # Add to TOP
        self.items.append(item)
    
    def pop(self):             # Remove/return TOP
        if self.items:
            return self.items.pop()
        return None  # Empty stack

## STEP 2: Add Helper Methods
    def peek(self):            # View TOP (no remove)
        if self.items:
            return self.items[-1]
        return None
    
    def isEmpty(self):         # Check empty?
        return len(self.items) == 0
    
    def size(self):            # Count items
        return len(self.items)

## STEP 3: Test It!
s = Stack()
print("Empty?", s.isEmpty())   # True

s.push(10); s.push(20); s.push(30)  # Stack: [10,20,30]
print("Size:", s.size())           # 3
print("Top:", s.peek())            # 30
print("Pop:", s.pop())             # 30
print("Now top:", s.peek())        # 20

print("Empty?", s.isEmpty())       # False

# OUTPUT:
# Empty? True
# Size: 3
# Top: 30
# Pop: 30
# Now top: 20
# Empty? False

