# 1. VALID PARENTHESES (LeetCode 20) - 80% interviews
def isValid(s):  # ()[]{}
    stack = Stack()
    pairs = {')':'(', '}':'{', ']':'['}
    for c in s:
        if c in pairs:  # Closing?
            if stack.isEmpty() or stack.pop() != pairs[c]:
                return False
        else: stack.push(c)  # Opening → push
    return stack.isEmpty()

