def insertion_sort(arr):
    # Traverse through 1 to len(arr)
    for i in range(1, len(arr)):        # i=1 (insert 11 into [12])
        key = arr[i]                    # key=11, arr=[12,11,13,5,6]
        
        # Move elements of arr[0..i-1], that are greater than key
        j = i - 1                       # j=0
        while j >= 0 and key < arr[j]:  # 0>=0 & 11<12 ✓
            arr[j + 1] = arr[j]         # arr[1]=12 → [12,12,13,5,6]
            j -= 1                      # j=-1
        arr[j + 1] = key                # arr[0]=11 → [11,12,13,5,6]
        
        # i=2 (insert 13 into [11,12])
        # i=3 (insert 5 into [11,12,13] → shifts all → [5,11,12,13,6])
        # i=4 (insert 6 into [5,11,12,13] → [5,6,11,12,13])

# Example usage:
data = [12, 11, 13, 5, 6]           # Start: [12,11,13,5,6]
insertion_sort(data)
print("Sorted array:", data)        # Final: [5,6,11,12,13]
